{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamha.local/schemas/records/relationship.schema.json",
  "title": "Relationship",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "createdAt",
    "updatedAt",
    "authority",
    "privacy",
    "provenance",
    "extensions",
    "fromPersonId",
    "toPersonId",
    "relationshipType",
    "certainty",
    "effectiveFrom",
    "effectiveTo",
    "status",
    "notes",
    "approvedBy",
    "rejection"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "authority": {
      "const": "AUTHORITATIVE_FILE_RECORD"
    },
    "privacy": {
      "$ref": "#/$defs/Privacy"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "extensions": {
      "$ref": "#/$defs/ExtensionMap"
    },
    "fromPersonId": {
      "$ref": "record-shared-v1.schema.json#/$defs/Id"
    },
    "toPersonId": {
      "$ref": "record-shared-v1.schema.json#/$defs/Id"
    },
    "relationshipType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "certainty": {
      "enum": [
        "SURE",
        "NOT_SURE"
      ]
    },
    "effectiveFrom": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "effectiveTo": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "FORMER"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "approvedBy": {
      "const": "USER"
    },
    "rejection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "rejectedAt": {
              "$ref": "record-shared-v1.schema.json#/$defs/Timestamp"
            },
            "suppressionScope": {
              "enum": [
                "EXACT_CANDIDATE",
                "EQUIVALENT_EVIDENCE"
              ]
            }
          },
          "required": [
            "reason",
            "rejectedAt",
            "suppressionScope"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "x-lamha": {
    "authority": "AUTHORITATIVE_FILE_RECORD",
    "privacyClassification": "LOCAL_USER_DATA",
    "stableIdStrategy": "UUIDv7 or documented deterministic content identity",
    "timestampSemantics": "UTC RFC3339 instants; source timezone retained in domain fields when required",
    "unknownFieldPolicy": "Core unknown fields rejected; scalar x-* extensions preserved",
    "migrationPolicy": "Monotonic versioned migration writes a new file atomically and leaves original bytes intact on failure"
  }
}
