{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamha.local/schemas/records/review_item.schema.json",
  "title": "Review Item",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "createdAt",
    "updatedAt",
    "authority",
    "privacy",
    "provenance",
    "extensions",
    "candidateType",
    "candidateId",
    "assetIds",
    "state",
    "decisionAt",
    "decisionReason",
    "suppressionScope"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "authority": {
      "const": "AUTHORITATIVE_FILE_RECORD"
    },
    "privacy": {
      "$ref": "#/$defs/Privacy"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "extensions": {
      "$ref": "#/$defs/ExtensionMap"
    },
    "candidateType": {
      "enum": [
        "OCR",
        "FACE",
        "DUPLICATE",
        "LOCATION",
        "TAG",
        "EVENT",
        "RELATIONSHIP",
        "METADATA_CONFLICT"
      ]
    },
    "candidateId": {
      "$ref": "record-shared-v1.schema.json#/$defs/Id"
    },
    "assetIds": {
      "type": "array",
      "items": {
        "$ref": "record-shared-v1.schema.json#/$defs/Id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "state": {
      "enum": [
        "OPEN",
        "APPROVED",
        "REJECTED",
        "DEFERRED",
        "SUPPRESSED"
      ]
    },
    "decisionAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "decisionReason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "suppressionScope": {
      "enum": [
        "NONE",
        "EXACT_CANDIDATE",
        "EQUIVALENT_EVIDENCE"
      ]
    }
  },
  "additionalProperties": false,
  "x-lamha": {
    "authority": "AUTHORITATIVE_FILE_RECORD",
    "privacyClassification": "LOCAL_USER_DATA",
    "stableIdStrategy": "UUIDv7 or documented deterministic content identity",
    "timestampSemantics": "UTC RFC3339 instants; source timezone retained in domain fields when required",
    "unknownFieldPolicy": "Core unknown fields rejected; scalar x-* extensions preserved",
    "migrationPolicy": "Monotonic versioned migration writes a new file atomically and leaves original bytes intact on failure"
  }
}
