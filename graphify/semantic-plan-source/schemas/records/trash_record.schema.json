{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamha.local/schemas/records/trash_record.schema.json",
  "title": "Trash Record",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "createdAt",
    "updatedAt",
    "authority",
    "privacy",
    "provenance",
    "extensions",
    "assetIdentityId",
    "originalPaths",
    "trashPaths",
    "trashedByOperationId",
    "trashedAt",
    "recoverableUntil",
    "state",
    "restoreOperationId"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "authority": {
      "const": "AUTHORITATIVE_FILE_RECORD"
    },
    "privacy": {
      "$ref": "#/$defs/Privacy"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "extensions": {
      "$ref": "#/$defs/ExtensionMap"
    },
    "assetIdentityId": {
      "$ref": "record-shared-v1.schema.json#/$defs/Id"
    },
    "originalPaths": {
      "type": "array",
      "items": {
        "$ref": "record-shared-v1.schema.json#/$defs/PathRef"
      },
      "minItems": 1
    },
    "trashPaths": {
      "type": "array",
      "items": {
        "$ref": "record-shared-v1.schema.json#/$defs/PathRef"
      },
      "minItems": 1
    },
    "trashedByOperationId": {
      "$ref": "record-shared-v1.schema.json#/$defs/Id"
    },
    "trashedAt": {
      "$ref": "record-shared-v1.schema.json#/$defs/Timestamp"
    },
    "recoverableUntil": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "state": {
      "enum": [
        "TRASHED",
        "RESTORE_PLANNED",
        "RESTORED",
        "PERMANENT_DELETE_PLANNED",
        "PERMANENTLY_DELETED"
      ]
    },
    "restoreOperationId": {
      "oneOf": [
        {
          "$ref": "record-shared-v1.schema.json#/$defs/Id"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "x-lamha": {
    "authority": "AUTHORITATIVE_FILE_RECORD",
    "privacyClassification": "LOCAL_USER_DATA",
    "stableIdStrategy": "UUIDv7 or documented deterministic content identity",
    "timestampSemantics": "UTC RFC3339 instants; source timezone retained in domain fields when required",
    "unknownFieldPolicy": "Core unknown fields rejected; scalar x-* extensions preserved",
    "migrationPolicy": "Monotonic versioned migration writes a new file atomically and leaves original bytes intact on failure"
  }
}
