{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamha.local/schemas/records/preview_index_entry.schema.json",
  "title": "Preview Index Entry",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "createdAt",
    "updatedAt",
    "authority",
    "privacy",
    "provenance",
    "extensions",
    "assetId",
    "assetRevision",
    "kind",
    "path",
    "mimeType",
    "width",
    "height",
    "durationMs",
    "generatorFingerprint"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "authority": {
      "const": "DERIVED_REBUILDABLE"
    },
    "privacy": {
      "$ref": "#/$defs/Privacy"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "extensions": {
      "$ref": "#/$defs/ExtensionMap"
    },
    "assetId": {
      "$ref": "record-shared-v1.schema.json#/$defs/Id"
    },
    "assetRevision": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "THUMBNAIL",
        "PREVIEW",
        "VIDEO_POSTER",
        "RAW_PREVIEW"
      ]
    },
    "path": {
      "$ref": "record-shared-v1.schema.json#/$defs/PathRef"
    },
    "mimeType": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "durationMs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "generatorFingerprint": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "x-lamha": {
    "authority": "DERIVED_REBUILDABLE",
    "privacyClassification": "LOCAL_USER_DATA",
    "stableIdStrategy": "UUIDv7 or documented deterministic content identity",
    "timestampSemantics": "UTC RFC3339 instants; source timezone retained in domain fields when required",
    "unknownFieldPolicy": "Core unknown fields rejected; scalar x-* extensions preserved",
    "migrationPolicy": "Monotonic versioned migration writes a new file atomically and leaves original bytes intact on failure"
  }
}
