{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamha.local/schemas/ipc/responses/ai.models.list_compatible.schema.json",
  "title": "List Compatible Response",
  "description": "Reviewed CAN-LAM-AI-090 response DTO for ai.models.list_compatible.",
  "type": "object",
  "required": [
    "contractVersion",
    "models",
    "revision"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "modelId",
          "variantId",
          "modelVersion",
          "checksum",
          "licenceId",
          "provider",
          "estimatedDurationSeconds",
          "estimatedMemoryBytes",
          "estimatedStorageBytes",
          "compatible",
          "hardBlockReason",
          "recommended"
        ],
        "properties": {
          "modelId": {
            "type": "string",
            "minLength": 1
          },
          "variantId": {
            "type": "string",
            "minLength": 1
          },
          "modelVersion": {
            "type": "string",
            "minLength": 1
          },
          "checksum": {
            "type": "string",
            "minLength": 1
          },
          "licenceId": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "enum": [
              "CPU",
              "CUDA",
              "DirectML",
              "CoreML",
              "ROCm"
            ]
          },
          "estimatedDurationSeconds": {
            "type": "integer",
            "minimum": 0
          },
          "estimatedMemoryBytes": {
            "type": "integer",
            "minimum": 0
          },
          "estimatedStorageBytes": {
            "type": "integer",
            "minimum": 0
          },
          "compatible": {
            "type": "boolean"
          },
          "hardBlockReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "recommended": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "x-lamha-review": {
    "status": "REVIEWED",
    "commandId": "ai.models.list_compatible",
    "side": "response",
    "openObjectExceptions": []
  }
}
