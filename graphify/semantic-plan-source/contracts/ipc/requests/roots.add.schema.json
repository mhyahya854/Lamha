{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamha.local/schemas/ipc/requests/roots.add.schema.json",
  "title": "Roots Add Request",
  "description": "Command-specific request DTO for roots.add.",
  "type": "object",
  "required": [
    "contractVersion",
    "requestId",
    "path",
    "accessMode"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "requestId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "accessMode": {
      "enum": [
        "READ_ONLY",
        "READ_WRITE"
      ]
    },
    "expectedDriveId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "x-lamha-review": {
    "status": "REVIEWED",
    "commandId": "roots.add",
    "side": "request",
    "openObjectExceptions": []
  }
}
