{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamha.local/schemas/ipc/requests/editing.render_preview.schema.json",
  "title": "Editing Render Preview Request",
  "description": "Command-specific request DTO for editing.render_preview.",
  "type": "object",
  "required": [
    "contractVersion",
    "requestId",
    "renderpreviewOptions"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "requestId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
