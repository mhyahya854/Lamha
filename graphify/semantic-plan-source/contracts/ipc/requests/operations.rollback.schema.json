{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamha.local/schemas/ipc/requests/operations.rollback.schema.json",
  "title": "Operations Rollback Request",
  "description": "Command-specific request DTO for operations.rollback.",
  "type": "object",
  "required": [
    "contractVersion",
    "requestId",
    "planId",
    "confirmationToken",
    "expectedRevision"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "requestId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "planId": {
      "type": "string"
    },
    "confirmationToken": {
      "type": "string",
      "minLength": 8
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "x-lamha-review": {
    "status": "REVIEWED",
    "commandId": "operations.rollback",
    "side": "request",
    "openObjectExceptions": []
  }
}
