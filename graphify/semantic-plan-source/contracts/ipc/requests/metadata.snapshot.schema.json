{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamha.local/schemas/ipc/requests/metadata.snapshot.schema.json",
  "title": "Metadata Snapshot Request",
  "description": "Command-specific request DTO for metadata.snapshot.",
  "type": "object",
  "required": [
    "contractVersion",
    "requestId",
    "snapshotOptions"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "requestId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "snapshotOptions": {
