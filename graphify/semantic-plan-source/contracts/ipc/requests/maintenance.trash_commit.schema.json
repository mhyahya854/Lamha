{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamha.local/schemas/ipc/requests/maintenance.trash_commit.schema.json",
  "title": "Maintenance Trash Commit Request",
  "description": "Command-specific request DTO for maintenance.trash_commit.",
  "type": "object",
  "required": [
    "contractVersion",
    "requestId",
    "planId",
    "confirmationToken",
    "expectedRevision"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "requestId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "planId": {
      "type": "string"
    },
    "confirmationToken": {
      "type": "string",
      "minLength": 8
    },
    "expectedRevision": {
