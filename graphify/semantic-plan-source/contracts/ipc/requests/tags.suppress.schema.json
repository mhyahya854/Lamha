{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamha.local/schemas/ipc/requests/tags.suppress.schema.json",
  "title": "Tags Suppress Request",
  "description": "Command-specific request DTO for tags.suppress.",
  "type": "object",
  "required": [
    "contractVersion",
    "requestId",
    "itemIds",
    "expectedRevision"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "requestId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "itemIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "x-lamha-review": {
    "status": "REVIEWED",
    "commandId": "tags.suppress",
    "side": "request",
    "openObjectExceptions": []
  }
}
