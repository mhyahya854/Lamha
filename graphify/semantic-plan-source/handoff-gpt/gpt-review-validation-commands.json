      "command": "Select-String -Path graphify\\12-semantic-implementation-plan\\13-reports\\final-100-percent-certification.json,graphify\\12-semantic-implementation-plan\\14-handoff\\START-HERE.md -Pattern 'FULL IMPLEMENTATION PLANNING 100% COMPLETE'",
