{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamha.local/schema/settings.schema.json",
  "title": "Lamha settings",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "createdAt",
    "updatedAt",
    "revision",
    "operator",
    "roots",
    "privacy",
    "ai",
    "appearance"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "operator": {
      "type": "object"
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "privacy": {
      "type": "object"
    },
    "ai": {
      "type": "object"
    },
    "appearance": {
      "type": "object"
    },
    "network": {
      "type": "object",
      "properties": {
        "allowOptionalOutbound": {
          "type": "boolean",
          "const": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
