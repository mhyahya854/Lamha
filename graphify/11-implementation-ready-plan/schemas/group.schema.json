{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamha.local/schema/group.schema.json",
  "title": "Lamha group record",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "createdAt",
    "updatedAt",
    "revision",
    "name"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "parentGroupId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "memberships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "personId"
        ],
        "properties": {
          "personId": {
            "type": "string",
            "format": "uuid"
          },
          "start": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "end": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
