{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamha.local/schema/relationship.schema.json",
  "title": "Lamha relationship edge",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "createdAt",
    "updatedAt",
    "revision",
    "fromPersonId",
    "toPersonId",
    "type",
    "certainty"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "fromPersonId": {
      "type": "string",
      "format": "uuid"
    },
    "toPersonId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "customType": {
      "type": "boolean"
    },
    "certainty": {
      "enum": [
        "sure",
        "not-sure"
      ]
    },
    "start": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "end": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "projection": {
      "type": "array",
      "items": {
        "enum": [
          "family",
          "friends",
          "family-friends"
        ]
      },
      "uniqueItems": true
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
