{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamha.local/schema/ai-task.schema.json",
  "title": "Lamha AI task state",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "createdAt",
    "updatedAt",
    "revision",
    "taskKind",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "taskKind": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "not-planned",
        "queued",
        "running",
        "paused",
        "completed",
        "failed",
        "cancelled",
        "stale",
        "rerun-required"
      ]
    },
    "modelId": {
      "type": [
        "string",
        "null"
      ]
    },
    "modelVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceFingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "configFingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "processedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "staleReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "lastError": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
