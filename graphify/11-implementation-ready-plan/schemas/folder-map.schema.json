{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamha.local/schema/folder-map.schema.json",
  "title": "Lamha folder map",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "createdAt",
    "updatedAt",
    "revision",
    "graphId",
    "scope",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "graphId": {
      "type": "string",
      "format": "uuid"
    },
    "scope": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "global",
            "root",
            "folder",
            "event",
            "branch",
            "person",
            "saved-focus"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "draftState": {
      "enum": [
        "draft",
        "ready",
        "materialized",
        "conflict",
        "failed"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "enum": [
              "folder",
              "event",
              "manage-later",
              "linked-folder",
              "context"
            ]
          },
          "state": {
            "type": "string"
          },
          "position": {
            "type": "object"
          },
          "domainId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "from": {
            "type": "string",
            "format": "uuid"
          },
          "to": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "plannedOperations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
