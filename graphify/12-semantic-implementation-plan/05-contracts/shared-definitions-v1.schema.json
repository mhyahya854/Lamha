{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamha.local/schemas/ipc/shared-definitions-v1.schema.json",
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Revision": {
      "type": "integer",
      "minimum": 0
    },
    "RequestId": {
      "type": "string",
      "format": "uuid"
    },
    "PathRef": {
      "type": "object",
      "properties": {
        "rootId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "expectedDriveId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "rootId",
        "relativePath"
      ],
      "additionalProperties": false
    },
    "PageRequest": {
      "type": "object",
      "properties": {
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      },
      "required": [
        "cursor",
        "limit"
      ],
      "additionalProperties": false
    },
    "PageInfo": {
      "type": "object",
      "properties": {
        "nextCursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "snapshotRevision": {
          "type": "integer",
          "minimum": 0
        },
        "returned": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "nextCursor",
        "snapshotRevision",
        "returned"
      ],
      "additionalProperties": false
    },
    "SortSpec": {
      "type": "object",
      "properties": {
        "field": {
          "enum": [
            "CAPTURED_AT",
            "CREATED_AT",
            "UPDATED_AT",
            "FILENAME",
            "TITLE",
            "RELEVANCE"
          ]
        },
        "direction": {
          "enum": [
            "ASC",
            "DESC"
          ]
        },
        "nulls": {
          "enum": [
            "FIRST",
            "LAST"
          ]
        }
      },
      "required": [
        "field",
        "direction",
        "nulls"
      ],
      "additionalProperties": false
    },
    "Conflict": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "REVISION",
            "PATH",
            "COLLISION",
            "AUTHORITY",
            "MISSING",
            "FORMAT"
          ]
        },
        "recordId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "recoverable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "recoverable"
      ],
      "additionalProperties": false
    },
    "Warning": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "recordId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "OperationHandle": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "enum": [
            "ACCEPTED",
            "RUNNING",
            "PAUSED",
            "CANCELLING",
            "COMMITTED",
            "FAILED",
            "CANCELLED",
            "RECOVERY_REQUIRED"
          ]
        },
        "acceptedAt": {
          "type": "string",
          "format": "date-time"
        },
        "cancellable": {
          "type": "boolean"
        },
        "resumeSupported": {
          "type": "boolean"
        }
      },
      "required": [
        "operationId",
        "requestId",
        "state",
        "acceptedAt",
        "cancellable",
        "resumeSupported"
      ],
      "additionalProperties": false
    },
    "MutationReceipt": {
      "type": "object",
      "properties": {
        "entityId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "enum": [
            "CREATED",
            "UPDATED",
            "DELETED",
            "CONFIRMED",
            "UNCHANGED"
          ]
        },
        "committedAt": {
          "type": "string",
          "format": "date-time"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Warning"
          },
          "minItems": 0
        }
      },
      "required": [
        "entityId",
        "revision",
        "state",
        "committedAt",
        "warnings"
      ],
      "additionalProperties": false
    },
    "StatusSnapshot": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "READY",
            "DEGRADED",
            "BUSY",
            "PAUSED",
            "DISCONNECTED",
            "RECOVERY_REQUIRED"
          ]
        },
        "snapshotRevision": {
          "type": "integer",
          "minimum": 0
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Warning"
          },
          "minItems": 0
        }
      },
      "required": [
        "state",
        "snapshotRevision",
        "observedAt",
        "warnings"
      ],
      "additionalProperties": false
    },
    "RootFilter": {
      "type": "object",
      "properties": {
        "state": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "CONNECTED",
            "DISCONNECTED",
            "READ_ONLY",
            "READ_WRITE",
            null
          ]
        },
        "includeUnavailable": {
          "type": "boolean"
        }
      },
      "required": [
        "state",
        "includeUnavailable"
      ],
      "additionalProperties": false
    },
    "RootSummary": {
      "type": "object",
      "properties": {
        "rootId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "path": {
          "$ref": "#/$defs/PathRef"
        },
        "accessMode": {
          "enum": [
            "READ_ONLY",
            "READ_WRITE"
          ]
        },
        "state": {
          "enum": [
            "CONNECTED",
            "DISCONNECTED",
            "MISMATCHED",
            "PERMISSION_DENIED"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "rootId",
        "displayName",
        "path",
        "accessMode",
        "state",
        "revision"
      ],
      "additionalProperties": false
    },
    "AssetFilter": {
      "type": "object",
      "properties": {
        "rootIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "mediaTypes": {
          "type": "array",
          "items": {
            "enum": [
              "IMAGE",
              "VIDEO",
              "AUDIO"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "capturedFrom": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "capturedTo": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "favorite": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reviewStates": {
          "type": "array",
          "items": {
            "enum": [
              "NONE",
              "OPEN",
              "DEFERRED",
              "RESOLVED"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "missingOnly": {
          "type": "boolean"
        }
      },
      "required": [
        "rootIds",
        "mediaTypes",
        "capturedFrom",
        "capturedTo",
        "favorite",
        "reviewStates",
        "missingOnly"
      ],
      "additionalProperties": false
    },
    "AssetListItem": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "identityId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "rootId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "mediaType": {
          "enum": [
            "IMAGE",
            "VIDEO",
            "AUDIO"
          ]
        },
        "mimeType": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "capturedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "durationMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "favorite": {
          "type": "boolean"
        },
        "previewRevision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "integrityState": {
          "enum": [
            "VERIFIED",
            "STALE",
            "MISSING",
            "MISMATCH",
            "UNKNOWN"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "assetId",
        "identityId",
        "rootId",
        "filename",
        "mediaType",
        "mimeType",
        "capturedAt",
        "width",
        "height",
        "durationMs",
        "favorite",
        "previewRevision",
        "integrityState",
        "revision"
      ],
      "additionalProperties": false
    },
    "AssetDetail": {
      "type": "object",
      "properties": {
        "summary": {
          "$ref": "#/$defs/AssetListItem"
        },
        "primaryPath": {
          "$ref": "#/$defs/PathRef"
        },
        "fileSizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "contentHash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{32,128}$"
        },
        "camera": {
          "$ref": "#/$defs/CameraMetadata"
        },
        "gps": {
          "$ref": "#/$defs/GpsMetadata"
        },
        "tagIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "albumIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "eventIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "personIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "sidecars": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SidecarSummary"
          },
          "minItems": 0
        },
        "companions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CompanionSummary"
          },
          "minItems": 0
        },
        "privacyState": {
          "enum": [
            "PRIVATE",
            "EXPORT_REDACT",
            "EXPORT_ALLOWED"
          ]
        }
      },
      "required": [
        "summary",
        "primaryPath",
        "fileSizeBytes",
        "contentHash",
        "camera",
        "gps",
        "tagIds",
        "albumIds",
        "eventIds",
        "personIds",
        "sidecars",
        "companions",
        "privacyState"
      ],
      "additionalProperties": false
    },
    "CameraMetadata": {
      "type": "object",
      "properties": {
        "make": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255
        },
        "lens": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255
        },
        "iso": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "aperture": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "exposureSeconds": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "focalLengthMm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cameraOwner": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      },
      "required": [
        "make",
        "model",
        "lens",
        "iso",
        "aperture",
        "exposureSeconds",
        "focalLengthMm",
        "cameraOwner"
      ],
      "additionalProperties": false
    },
    "GpsMetadata": {
      "type": "object",
      "properties": {
        "latitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "altitudeMeters": {
          "type": [
            "number",
            "null"
          ]
        },
        "source": {
          "enum": [
            "EMBEDDED",
            "XMP",
            "ASSET_JSON",
            "USER",
            "AI_PROPOSAL",
            "NONE"
          ]
        }
      },
      "required": [
        "latitude",
        "longitude",
        "altitudeMeters",
        "source"
      ],
      "additionalProperties": false
    },
    "SidecarSummary": {
      "type": "object",
      "properties": {
        "sidecarId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "kind": {
          "enum": [
            "ASSET_JSON",
            "XMP",
            "EXTERNAL_XMP"
          ]
        },
        "path": {
          "$ref": "#/$defs/PathRef"
        },
        "state": {
          "enum": [
            "HEALTHY",
            "MISSING",
            "CORRUPT",
            "FUTURE_VERSION",
            "PENDING_OVERLAY"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "sidecarId",
        "kind",
        "path",
        "state",
        "revision"
      ],
      "additionalProperties": false
    },
    "CompanionSummary": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "kind": {
          "enum": [
            "LIVE_PHOTO_IMAGE",
            "LIVE_PHOTO_VIDEO",
            "RAW",
            "JPEG_RENDER",
            "MOTION_PHOTO"
          ]
        },
        "bundleRole": {
          "enum": [
            "PRIMARY",
            "COMPANION"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "assetId",
        "kind",
        "bundleRole",
        "revision"
      ],
      "additionalProperties": false
    },
    "SearchFilter": {
      "type": "object",
      "properties": {
        "asset": {
          "$ref": "#/$defs/AssetFilter"
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "ocr": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "personIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "tagIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "eventIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "locationRadius": {
          "$ref": "#/$defs/LocationRadius"
        }
      },
      "required": [
        "asset",
        "text",
        "ocr",
        "personIds",
        "tagIds",
        "eventIds",
        "locationRadius"
      ],
      "additionalProperties": false
    },
    "LocationRadius": {
      "type": "object",
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "radiusMeters": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        }
      },
      "required": [
        "latitude",
        "longitude",
        "radiusMeters"
      ],
      "additionalProperties": false
    },
    "SearchHit": {
      "type": "object",
      "properties": {
        "asset": {
          "$ref": "#/$defs/AssetListItem"
        },
        "score": {
          "type": "number",
          "minimum": 0
        },
        "matchedFields": {
          "type": "array",
          "items": {
            "enum": [
              "FILENAME",
              "METADATA",
              "OCR",
              "PERSON",
              "TAG",
              "EVENT",
              "LOCATION",
              "EMBEDDING"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "explanation": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "asset",
        "score",
        "matchedFields",
        "explanation"
      ],
      "additionalProperties": false
    },
    "EventDraft": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "startAt": {
          "type": "string",
          "format": "date-time"
        },
        "endAt": {
          "type": "string",
          "format": "date-time"
        },
        "timeZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "location": {
          "$ref": "#/$defs/GpsMetadata"
        },
        "assetIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "attendeePersonIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "photographerPersonIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "expectedRevision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "title",
        "startAt",
        "endAt",
        "timeZone",
        "assetIds"
      ],
      "additionalProperties": false
    },
    "EventSummary": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "startAt": {
          "type": "string",
          "format": "date-time"
        },
        "endAt": {
          "type": "string",
          "format": "date-time"
        },
        "assetCount": {
          "type": "integer",
          "minimum": 0
        },
        "reviewState": {
          "enum": [
            "DRAFT",
            "PROPOSED",
            "CONFIRMED",
