{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamha.local/schemas/ipc/requests/maintenance.rebuild_plan.schema.json",
  "title": "Maintenance Rebuild Plan Request",
  "description": "Command-specific request DTO for maintenance.rebuild_plan.",
  "type": "object",
  "required": [
    "contractVersion",
    "requestId",
    "subjectIds",
    "planOptions",
    "dryRun"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "requestId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "subjectIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "planOptions": {
      "$ref": "../../shared-definitions-v1.schema.json#/$defs/OperationPlanOptions"
    },
    "dryRun": {
      "const": true
    }
  },
  "additionalProperties": false,
  "x-lamha-review": {
    "status": "REVIEWED",
    "commandId": "maintenance.rebuild_plan",
    "side": "request",
    "openObjectExceptions": []
  }
}
