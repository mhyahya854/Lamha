{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamha.local/schemas/ipc/requests/roots.choose.schema.json",
  "title": "Roots Choose Request",
  "description": "Command-specific request DTO for roots.choose.",
  "type": "object",
  "required": [
    "contractVersion",
    "requestId",
    "selectedPath",
    "accessMode"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "requestId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "selectedPath": {
      "type": "string",
      "minLength": 1
    },
    "accessMode": {
      "enum": [
        "READ_ONLY",
        "READ_WRITE"
      ]
    }
  },
  "additionalProperties": false,
  "x-lamha-review": {
    "status": "REVIEWED",
    "commandId": "roots.choose",
    "side": "request",
    "openObjectExceptions": []
  }
}
