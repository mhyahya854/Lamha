{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamha.local/schemas/records/event.schema.json",
  "title": "Event",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "createdAt",
    "updatedAt",
    "authority",
    "privacy",
    "provenance",
    "extensions",
    "title",
    "startAt",
    "endAt",
    "timeZone",
    "location",
    "assetMemberships",
    "folderState",
    "inference",
    "attendeePersonIds",
    "photographerPersonIds",
    "conflictState",
    "history",
    "reviewState"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "authority": {
      "const": "AUTHORITATIVE_FILE_RECORD"
    },
    "privacy": {
      "$ref": "#/$defs/Privacy"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "extensions": {
      "$ref": "#/$defs/ExtensionMap"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "startAt": {
      "$ref": "record-shared-v1.schema.json#/$defs/Timestamp"
    },
    "endAt": {
      "$ref": "record-shared-v1.schema.json#/$defs/Timestamp"
    },
    "timeZone": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "oneOf": [
        {
          "$ref": "record-shared-v1.schema.json#/$defs/Gps"
        },
        {
          "type": "null"
        }
      ]
    },
    "assetMemberships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assetId": {
            "$ref": "record-shared-v1.schema.json#/$defs/Id"
          },
          "role": {
            "enum": [
              "PRIMARY",
              "MEMBER",
              "BACKDROP"
            ]
          },
          "addedAt": {
            "$ref": "record-shared-v1.schema.json#/$defs/Timestamp"
          }
        },
        "required": [
          "assetId",
          "role",
          "addedAt"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "folderState": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "VIRTUAL",
            "PLANNED",
            "MATERIALIZED",
            "CONFLICT"
          ]
        },
        "path": {
          "oneOf": [
            {
              "$ref": "record-shared-v1.schema.json#/$defs/PathRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "operationId": {
          "oneOf": [
            {
              "$ref": "record-shared-v1.schema.json#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "inference": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "USER",
            "DATE_LOCATION_HEURISTIC",
            "AI_PROPOSAL"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "candidateId": {
          "oneOf": [
            {
              "$ref": "record-shared-v1.schema.json#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "userConfirmed": {
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "confidence",
        "candidateId",
        "userConfirmed"
      ],
      "additionalProperties": false
    },
    "attendeePersonIds": {
      "type": "array",
      "items": {
        "$ref": "record-shared-v1.schema.json#/$defs/Id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "photographerPersonIds": {
      "type": "array",
      "items": {
        "$ref": "record-shared-v1.schema.json#/$defs/Id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "conflictState": {
      "enum": [
        "NONE",
        "DATE",
        "LOCATION",
        "MEMBERSHIP",
        "FILESYSTEM"
      ]
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "enum": [
              "MERGE",
              "SPLIT",
              "LINK",
              "UNLINK",
              "RENAME"
            ]
          },
          "relatedEventIds": {
            "type": "array",
            "items": {
              "$ref": "record-shared-v1.schema.json#/$defs/Id"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "at": {
            "$ref": "record-shared-v1.schema.json#/$defs/Timestamp"
          },
          "operationId": {
            "oneOf": [
              {
                "$ref": "record-shared-v1.schema.json#/$defs/Id"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "action",
          "relatedEventIds",
          "at",
          "operationId"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "reviewState": {
      "enum": [
        "DRAFT",
        "PROPOSED",
        "CONFIRMED",
        "REJECTED",
        "CONFLICT"
      ]
    }
  },
  "additionalProperties": false,
  "x-lamha": {
    "authority": "AUTHORITATIVE_FILE_RECORD",
    "privacyClassification": "LOCAL_USER_DATA",
    "stableIdStrategy": "UUIDv7 or documented deterministic content identity",
    "timestampSemantics": "UTC RFC3339 instants; source timezone retained in domain fields when required",
    "unknownFieldPolicy": "Core unknown fields rejected; scalar x-* extensions preserved",
    "migrationPolicy": "Monotonic versioned migration writes a new file atomically and leaves original bytes intact on failure"
  }
}
