{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamha.local/schemas/records/privacy_export_recipe.schema.json",
  "title": "Privacy Export Recipe",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "createdAt",
    "updatedAt",
    "authority",
    "privacy",
    "provenance",
    "extensions",
    "name",
    "removeFields",
    "includeDerivatives",
    "preserveCaptureTime",
    "outputMetadataPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "$ref": "record-shared-v1.schema.json#/$defs/Id"
    },
    "revision": {
      "$ref": "record-shared-v1.schema.json#/$defs/Revision"
    },
    "createdAt": {
      "$ref": "record-shared-v1.schema.json#/$defs/Timestamp"
    },
    "updatedAt": {
      "$ref": "record-shared-v1.schema.json#/$defs/Timestamp"
    },
    "authority": {
      "const": "AUTHORITATIVE_FILE_RECORD"
    },
    "privacy": {
      "$ref": "record-shared-v1.schema.json#/$defs/Privacy"
    },
    "provenance": {
      "$ref": "record-shared-v1.schema.json#/$defs/Provenance"
    },
    "extensions": {
      "$ref": "record-shared-v1.schema.json#/$defs/ExtensionMap"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "removeFields": {
      "type": "array",
      "items": {
        "enum": [
          "GPS",
          "CAMERA_OWNER",
          "PHOTOGRAPHER",
          "IMPORTER",
          "VISIBLE_PEOPLE",
          "EVENT_MEMBERSHIP",
          "TAGS",
          "CAPTURE_TIME",
          "DEVICE_IDENTIFIERS"
        ]
      },
      "uniqueItems": true
    },
    "includeDerivatives": {
      "type": "boolean"
    },
    "preserveCaptureTime": {
      "type": "boolean"
    },
    "outputMetadataPolicy": {
      "enum": [
        "STRIP_ALL",
        "ALLOWLIST",
        "RECIPE_FIELDS"
      ]
    }
  },
  "$defs": {},
  "additionalProperties": false,
  "x-lamha": {
    "authority": "AUTHORITATIVE_FILE_RECORD",
    "privacyClassification": "LOCAL_USER_DATA",
    "stableIdStrategy": "UUIDv7 or documented deterministic identity",
    "timestampSemantics": "UTC RFC3339 instants",
    "unknownFieldPolicy": "Core unknown fields rejected; scalar x-* extensions preserved",
    "migrationPolicy": "Monotonic versioned migration writes a new file atomically and preserves the prior valid revision on failure"
  }
}
