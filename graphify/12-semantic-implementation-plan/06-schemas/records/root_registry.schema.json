{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamha.local/schemas/records/root_registry.schema.json",
  "title": "Root Registry",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "createdAt",
    "updatedAt",
    "authority",
    "privacy",
    "provenance",
    "extensions",
    "path",
    "displayName",
    "accessMode",
    "driveId",
    "state",
    "lastVerifiedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "authority": {
      "const": "AUTHORITATIVE_FILE_RECORD"
    },
    "privacy": {
      "$ref": "#/$defs/Privacy"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "extensions": {
      "$ref": "#/$defs/ExtensionMap"
    },
    "path": {
      "$ref": "record-shared-v1.schema.json#/$defs/PathRef"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "accessMode": {
      "enum": [
        "READ_ONLY",
        "READ_WRITE"
      ]
    },
    "driveId": {
      "oneOf": [
        {
          "$ref": "record-shared-v1.schema.json#/$defs/Id"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "enum": [
        "CONNECTED",
        "DISCONNECTED",
        "MISMATCHED",
        "PERMISSION_DENIED"
      ]
    },
    "lastVerifiedAt": {
      "$ref": "record-shared-v1.schema.json#/$defs/Timestamp"
    }
  },
  "additionalProperties": false,
  "x-lamha": {
    "authority": "AUTHORITATIVE_FILE_RECORD",
    "privacyClassification": "LOCAL_USER_DATA",
    "stableIdStrategy": "UUIDv7 or documented deterministic content identity",
    "timestampSemantics": "UTC RFC3339 instants; source timezone retained in domain fields when required",
    "unknownFieldPolicy": "Core unknown fields rejected; scalar x-* extensions preserved",
    "migrationPolicy": "Monotonic versioned migration writes a new file atomically and leaves original bytes intact on failure"
  }
}
